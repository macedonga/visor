<?xml version="1.0" encoding="utf-8"?>
<!-- What Visor hands to other apps when sharing: the photos Meta AI answered with, and the event log. -->
<paths>
    <files-path name="assistant" path="assistant/photos/" />
    <cache-path name="log" path="log/" />
    <!-- A picture sent from the glasses as an MMS, read by the phone's MMS service. -->
    <cache-path name="mms" path="mms/" />
</paths>
