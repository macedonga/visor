<?xml version="1.0" encoding="utf-8"?>
<!-- The connection notification: system text styles, icons tinted from code. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical">

    <TextView
        android:id="@+id/title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:singleLine="true"
        android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

    <LinearLayout
        android:id="@+id/readouts"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/glasses_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_glasses" />

        <TextView
            android:id="@+id/glasses"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />

        <ImageView
            android:id="@+id/bolt"
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:layout_marginStart="2dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_widget_bolt"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/case_icon"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:layout_marginStart="18dp"
            android:importantForAccessibility="no"
            android:src="@drawable/ic_notify_case" />

        <TextView
            android:id="@+id/case_level"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:importantForAccessibility="no"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
</LinearLayout>
